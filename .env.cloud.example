# ===== CORE CONFIGURATION =====
# Server URL (used for callbacks, Sentry, etc.)
APP_BASE_URL=https://youtube-bird-studio.onrender.com

# Debug mode (disable in production)
DEBUG=false

# ===== DATABASE =====
# PostgreSQL connection string (auto-set by Render)
DATABASE_URL=postgresql://youtube_bird_user:password@youtube-bird-db:5432/youtube_bird

# ===== CACHE =====
# Redis connection string (auto-set by Render)
REDIS_URL=redis://youtube-bird-cache:6379/0

# ===== SECURITY =====
# Session secret key (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-min-32-characters-long-replace-this

# Cross-origin allowed origins (comma-separated)
ALLOWED_ORIGINS=https://youtube-bird-studio.onrender.com,https://yourdomain.com

# ===== AUTHENTICATION =====
# Authentication mode: local, google, or oauth
AUTH_MODE=google

# Auth user header (from reverse proxy or IAP)
# Google IAP: X-Goog-Authenticated-User-Email
# Cloudflare Access: Cf-Access-Authenticated-User-Email
AUTH_USER_HEADER=X-Authenticated-User

# ===== OAUTH / SOCIAL LOGIN =====
# Google OAuth (for Google Sign-In)
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# ===== YOUTUBE =====
# YouTube API credentials (for video uploads)
YOUTUBE_API_PROJECT_ID=your-google-project-id
YOUTUBE_API_KEY=your-youtube-api-key

# ===== INSTAGRAM =====
# Instagram Graph API
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret

# ===== STRIPE (Payment Processing) =====
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# ===== ERROR TRACKING & MONITORING =====
# Sentry (error tracking)
SENTRY_DSN=https://your-key@sentry.io/your-project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ===== LOGGING =====
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ===== MULTI-USER / TENANCY =====
MULTI_USER_ROOT=data/users

# ===== FEATURE FLAGS =====
PUBLIC_CLOUD=true
INSTAGRAM_ENABLED=true
YOUTUBE_ENABLED=true

# ===== MONEYPRINTER TURBO =====
MONEYPRINTER_TURBO_COMMAND=python main.py
MONEYPRINTER_TURBO_ROOT=./external/MoneyPrinterTurbo
